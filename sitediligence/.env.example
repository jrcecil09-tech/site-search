# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sitediligence
POSTGRES_DB=sitediligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── API ───────────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000
SECRET_KEY=change-me-in-production

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local          # local | s3 | azure | gcs
STORAGE_LOCAL_PATH=./data/storage

# S3 / Compatible (Cloudflare R2, MinIO, etc.)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=               # leave blank for AWS S3

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Google Cloud Storage
GCS_BUCKET=
GCS_CREDENTIALS_FILE=

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
