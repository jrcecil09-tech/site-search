      "wms": {
        "url": "https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer/WMSServer",
        "layer": "28",
        "format": "image/png",
        "transparent": true
      },
      "display": {
        "opacity": 0.5,
        "zone_colors": {
          "AE":  "#f97316",
          "VE":  "#ef4444",
          "A":   "#fb923c",
          "AH":  "#f59e0b",
          "AO":  "#fbbf24",
          "X":   "#d1d5db",
          "D":   "#e5e7eb"
        }
      },
      "docs_url": "https://msc.fema.gov/portal/home"
