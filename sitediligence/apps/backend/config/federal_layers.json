    {
      "id": "wetlands",
      "name": "NWI Wetlands",
      "agency": "USFWS",
      "program": "National Wetlands Inventory",
      "category": "environmental",
      "color": "#2c7bb6",
      "regulatory_flags": ["CWA Section 404", "CWA Section 401"],
      "service": {
        "type": "arcgis_mapserver",
        "base_url": "https://fwspublicservices.wim.usgs.gov/wetlandsmapservice/rest/services/Wetlands/MapServer",
        "layer_id": 0,
        "query_fields": ["ATTRIBUTE", "WETLAND_TYPE", "ACRES", "GLOBALID"],
        "geometry_type": "polygon",
        "spatial_ref": 4326
      },
      "wms": {
        "url": "https://fwspublicservices.wim.usgs.gov/wetlandsmapservice/rest/services/Wetlands/MapServer/WMSServer",
        "layer": "Wetlands",
        "format": "image/png",
        "transparent": true
      },
      "display": {
        "opacity": 0.6,
        "system_colors": {
          "Palustrine": "#1a9850",
          "Estuarine":  "#2c7bb6",
          "Riverine":   "#74add1",
          "Lacustrine": "#abd9e9",
          "Marine":     "#4575b4"
        }
      },
      "docs_url": "https://www.fws.gov/program/national-wetlands-inventory/wetlands-mapper"
    },
    {
      "id": "flood_zones",
